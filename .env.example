# ---------------------------------------------------------------------------
# AI Pronunciation Coach — Environment Configuration
# Copy this file to .env and adjust values as needed.
# ---------------------------------------------------------------------------

# Database for accounts and practice history. PostgreSQL (e.g. Neon) in production;
# defaults to a local SQLite file when unset. DATABASE_URL, POSTGRES_URL and
# POSTGRESQL_URL are also read. A SQLite file inside a container is erased on
# every restart, so a hosted app needs a real database URL here.
# NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Whisper model size to load.
# Options: tiny, base, small, medium, large
# Larger models are more accurate but require more RAM and are slower on CPU.
WHISPER_MODEL_SIZE=base

# Epitran language code for the optional out-of-dictionary fallback
# (needs `pip install epitran` and Flite; built-in rules are used otherwise).
PRONUNCIATION_LANGUAGE=eng-Latn

# Speech recognition (faster-whisper). Defaults suit a small CPU server.
# PRONUNCIATION_COACH_ASR_DEVICE=auto          # cpu | cuda | auto
# PRONUNCIATION_COACH_ASR_COMPUTE_TYPE=auto    # int8 on CPU, float16 on GPU
# PRONUNCIATION_COACH_ASR_BEAM_SIZE=5
# PRONUNCIATION_COACH_ASR_THREADS=0            # 0 = all cores
# PRONUNCIATION_COACH_ASR_CONCURRENCY=1        # transcriptions run at once
# PRONUNCIATION_COACH_ASR_QUEUE_LIMIT=8        # waiting requests before 503 + Retry-After
# PRONUNCIATION_COACH_ASR_DIR=/app/.cache/whisper
# PRONUNCIATION_COACH_MAX_AUDIO_SECONDS=60

# Set to 0 to skip loading Whisper on startup.
# Useful for fast API tests or frontend-only development.
PRONUNCIATION_COACH_LOAD_MODELS_ON_STARTUP=1

# Maximum audio upload size in bytes (default: 25 MB).
PRONUNCIATION_COACH_MAX_UPLOAD_BYTES=26214400

# Audio requests (evaluate/transcribe) allowed per client IP per minute. 0 disables.
PRONUNCIATION_COACH_RATE_LIMIT=30

# Comma-separated list of allowed CORS origins.
# Leave unset to use built-in localhost defaults (incl. the Vite dev server).
# PRONUNCIATION_COACH_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Where the built React app lives (defaults to frontend/dist).
# PRONUNCIATION_COACH_FRONTEND_DIR=/app/frontend/dist

# Neural coach voice (Piper, offline). Served at /api/tts so the UI can analyse
# the audio and animate the orb in sync. Set to 0 to use browser speech only.
PRONUNCIATION_COACH_TTS=1
PRONUNCIATION_COACH_TTS_VOICE=en_US-lessac-medium
# Voice engine: auto uses Kokoro when its files are installed, otherwise Piper.
# PRONUNCIATION_COACH_TTS_ENGINE=auto          # auto | kokoro | piper
# PRONUNCIATION_COACH_KOKORO_VOICE=af_heart    # af_* / am_* American, bf_* / bm_* British
# PRONUNCIATION_COACH_KOKORO_DIR=~/.cache/pronunciation_coach/kokoro
# Where voice models are cached (downloaded on first start if missing).
# PRONUNCIATION_COACH_TTS_DIR=/app/.cache/piper

# Pages allowed to embed the app (Content-Security-Policy frame-ancestors).
# PRONUNCIATION_COACH_FRAME_ANCESTORS='self' https://huggingface.co https://*.hf.space

# Observability: Prometheus metrics at /metrics (optionally behind a bearer token),
# log level, and text or json log lines.
# PRONUNCIATION_COACH_METRICS=1
# PRONUNCIATION_COACH_METRICS_TOKEN=
# PRONUNCIATION_COACH_LOG_LEVEL=INFO
# PRONUNCIATION_COACH_LOG_FORMAT=text

# Personalised coaching text (POST /api/coach). Get a key at console.groq.com and
# keep it in this file or your host's secrets, never in the repository. Without
# a key the built-in tips are used. Only the sentence and the diagnosed sounds
# are sent, never audio or names.
# GROQ_API_KEY=
# PRONUNCIATION_COACH_LLM_MODEL=openai/gpt-oss-120b
# PRONUNCIATION_COACH_LLM_TIMEOUT=8

# Set to 1 to enable the /api/agent/analyze endpoint (disabled in production).
PRONUNCIATION_COACH_ENABLE_AGENT=0

# Frontend only (build time): API origin when the UI is hosted separately.
# VITE_API_URL=https://your-api.example.com
