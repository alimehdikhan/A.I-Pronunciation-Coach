# ---------------------------------------------------------------------------
# Vocaly AI — Environment Configuration
# Copy this file to .env and adjust values as needed.
# ---------------------------------------------------------------------------

# Database for accounts and practice history. PostgreSQL (e.g. Neon) in production;
# defaults to a local SQLite file when unset. DATABASE_URL, POSTGRES_URL and
# POSTGRESQL_URL are also read. A SQLite file inside a container is erased on
# every restart, so a hosted app needs a real database URL here.
# NEON_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Speech recognition. With GROQ_API_KEY set (below), every recording is transcribed by Groq's hosted
# Whisper large (whisper-large-v3); the local Whisper below loads only if Groq fails or its limit is
# reached. "local" keeps all of it on this server.
# PRONUNCIATION_COACH_ASR_ENGINE=auto
# PRONUNCIATION_COACH_GROQ_ASR_MODEL=whisper-large-v3

# With Groq, the local Whisper model that stands in when Groq fails (loaded only then).
# PRONUNCIATION_COACH_FALLBACK_WHISPER=base

# The local Whisper model size without a Groq key (or with ASR_ENGINE=local).
# Options: tiny, base, small, medium, large
# Larger models are more accurate but require more RAM and are slower on CPU.
WHISPER_MODEL_SIZE=base

# Epitran language code for the optional out-of-dictionary fallback
# (needs `pip install epitran` and Flite; built-in rules are used otherwise).
PRONUNCIATION_LANGUAGE=eng-Latn

# Speech recognition (faster-whisper). Defaults suit a small CPU server.
# PRONUNCIATION_COACH_ASR_DEVICE=auto          # cpu | cuda | auto
# PRONUNCIATION_COACH_ASR_COMPUTE_TYPE=auto    # int8 on CPU, float16 on GPU
# PRONUNCIATION_COACH_ASR_BEAM_SIZE=5
# PRONUNCIATION_COACH_ASR_THREADS=0            # 0 = all cores
# PRONUNCIATION_COACH_ASR_CONCURRENCY=1        # transcriptions run at once
# PRONUNCIATION_COACH_ASR_QUEUE_LIMIT=8        # waiting requests before 503 + Retry-After
# PRONUNCIATION_COACH_ASR_DIR=/app/.cache/whisper
# PRONUNCIATION_COACH_MAX_AUDIO_SECONDS=60

# Set to 0 to skip loading Whisper on startup.
# Useful for fast API tests or frontend-only development.
PRONUNCIATION_COACH_LOAD_MODELS_ON_STARTUP=1

# Maximum audio upload size in bytes (default: 25 MB).
PRONUNCIATION_COACH_MAX_UPLOAD_BYTES=26214400

# Audio requests (evaluate/transcribe) allowed per client IP per minute. 0 disables.
PRONUNCIATION_COACH_RATE_LIMIT=30

# Comma-separated list of allowed CORS origins.
# Leave unset to use built-in localhost defaults (incl. the Vite dev server).
# PRONUNCIATION_COACH_CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# Where the built React app lives (defaults to frontend/dist).
# PRONUNCIATION_COACH_FRONTEND_DIR=/app/frontend/dist

# Neural coach voice (Piper, offline). Served at /api/tts so the UI can analyse
# the audio and animate the orb in sync. Set to 0 to use browser speech only.
PRONUNCIATION_COACH_TTS=1
PRONUNCIATION_COACH_TTS_VOICE=en_US-lessac-medium
# Voice engine: auto uses Kokoro when its files are installed, otherwise Piper.
# PRONUNCIATION_COACH_TTS_ENGINE=auto          # auto | kokoro | piper
# PRONUNCIATION_COACH_KOKORO_VOICE=af_heart    # af_* / am_* American, bf_* / bm_* British
# PRONUNCIATION_COACH_KOKORO_DIR=~/.cache/pronunciation_coach/kokoro
# Where voice models are cached (downloaded on first start if missing).
# PRONUNCIATION_COACH_TTS_DIR=/app/.cache/piper

# Pages allowed to embed the app (Content-Security-Policy frame-ancestors).
# PRONUNCIATION_COACH_FRAME_ANCESTORS='self' https://huggingface.co https://*.hf.space

# Observability: Prometheus metrics at /metrics (optionally behind a bearer token),
# log level, and text or json log lines.
# PRONUNCIATION_COACH_METRICS=1
# PRONUNCIATION_COACH_METRICS_TOKEN=
# PRONUNCIATION_COACH_LOG_LEVEL=INFO
# PRONUNCIATION_COACH_LOG_FORMAT=text

# Groq: speech recognition (the audio of recordings, see ASR_ENGINE above) and personalised coaching
# text (POST /api/coach). Get a key at console.groq.com and keep it in this file or your host's secrets,
# never in the repository. Without a key the built-in tips and the local Whisper are used.
# GROQ_API_KEY=
# PRONUNCIATION_COACH_LLM_MODEL=openai/gpt-oss-120b
# PRONUNCIATION_COACH_LLM_TIMEOUT=8

# Set to 1 to enable the /api/agent/analyze endpoint (disabled in production).
PRONUNCIATION_COACH_ENABLE_AGENT=0

# Frontend only (build time): API origin when the UI is hosted separately.
# VITE_API_URL=https://your-api.example.com

# Live voice conversations with the coach (Gemini Live). Leave empty to hide the Talk buttons.
GEMINI_API_KEY=

# Every learner feature needs a signed-in account. 0 lets guests practise without one.
# PRONUNCIATION_COACH_REQUIRE_ACCOUNT=1

# "Continue with Google" (optional). Create an OAuth client ID (type "Web application") in Google Cloud
# and add <your app address>/api/auth/google/callback as an authorised redirect URI. Without both, the button is hidden.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Password reset by email (optional). Without a host and sender the "Forgot password?" link is hidden.
# PRONUNCIATION_COACH_SMTP_HOST=smtp.example.com
# PRONUNCIATION_COACH_SMTP_PORT=587
# PRONUNCIATION_COACH_SMTP_USER=
# PRONUNCIATION_COACH_SMTP_PASSWORD=
# PRONUNCIATION_COACH_MAIL_FROM=coach@example.com
# PRONUNCIATION_COACH_PUBLIC_URL=https://coach.example.com

# Who runs this copy and how to reach them, shown on the Privacy, Terms and About pages.
# Without an email, those pages point to the project's GitHub issues.
# PRONUNCIATION_COACH_OPERATOR=Ali Mehdi Khan
# PRONUNCIATION_COACH_CONTACT_EMAIL=you@example.com

# Longest answer in a mock interview, in seconds, and days between Day 1 vs Day 30 recordings.
# PRONUNCIATION_COACH_INTERVIEW_SECONDS=150
# PRONUNCIATION_COACH_COMPARE_DAYS=30

# Sound models tuned per first language (backend/data/sound_models, made by
# scripts/train_sound_model.py). Set to 0 to score everyone with the default curve.
# PRONUNCIATION_COACH_SOUND_MODELS=1

# "Help improve Vocaly AI" (Settings): signed-in learners can give clean recordings of the
# app's practice sentences to train the scoring. Off until the token is set. The dataset must
# be PRIVATE (the uploader refuses a public one); give the token write access to that dataset
# only, and keep it in your host's secrets, never in the repository. On a Hugging Face Space the
# dataset defaults to <your name>/vocaly-recordings, so the token is the only secret to add.
# PRONUNCIATION_COACH_DATASET_REPO=your-name/vocaly-recordings
# PRONUNCIATION_COACH_DATASET_TOKEN=
# PRONUNCIATION_COACH_CONTRIB_UPLOAD_MINUTES=10   # how often queued recordings are uploaded
# PRONUNCIATION_COACH_CONTRIB_DAILY_LIMIT=100     # recordings kept per learner per day
# PRONUNCIATION_COACH_CONTRIB_DIR=~/.cache/pronunciation_coach/contributions
